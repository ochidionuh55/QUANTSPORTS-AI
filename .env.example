# ============================================================================
# QUANTSPORT AI - environment configuration
#
# Copy to .env and fill in:
#   cp .env.example .env
#
# NEVER commit .env.
#
# IMPORTANT: comments must be on their own line. Docker Compose does not
# reliably strip trailing comments from an env_file, so writing
#     KEY=value   # explanation
# can pass the literal text "value   # explanation" to the application.
# ============================================================================


# --- Application ------------------------------------------------------------
APP_NAME="QUANTSPORT AI"

# development | staging | production | test
ENVIRONMENT=development

# Set per process by docker-compose; leave as api for local runs.
SERVICE_ROLE=api

DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
API_ROOT_PATH=


# --- PostgreSQL -------------------------------------------------------------
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=quantsport
POSTGRES__PASSWORD=change-me-in-production
POSTGRES__DATABASE=quantsport
POSTGRES__POOL_SIZE=5
POSTGRES__MAX_OVERFLOW=10
POSTGRES__ECHO_SQL=false

# Tuning knobs. Defaults are sensible; uncomment only to override.
# POSTGRES__POOL_TIMEOUT_SECONDS=10
# POSTGRES__POOL_RECYCLE_SECONDS=1800
# POSTGRES__CONNECT_TIMEOUT_SECONDS=5


# --- Redis (mandatory, not optional) ---------------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DATABASE=0
REDIS__MAX_CONNECTIONS=20
REDIS__KEY_PREFIX=quantsport

# REDIS__PASSWORD=
# REDIS__SOCKET_TIMEOUT_SECONDS=3
# REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=3


# --- Telegram ---------------------------------------------------------------
# Required only for the bot process. Get a token from @BotFather.
# The bot container will restart-loop while this is empty.
TELEGRAM__BOT_TOKEN=

TELEGRAM__PARSE_MODE=HTML

# Comma-separated numeric Telegram user IDs, e.g. 12345678,87654321
TELEGRAM__ADMIN_IDS=

TELEGRAM__DROP_PENDING_UPDATES=true

# TELEGRAM__REQUEST_TIMEOUT_SECONDS=30


# --- Live data providers ----------------------------------------------------
# API-Football key from https://dashboard.api-football.com. The free tier
# allows 100 requests per day, which is enough for a beta that caches fixtures
# once daily. Without a key the application falls back to mock providers.
API_FOOTBALL_KEY=


# --- Feature flags ----------------------------------------------------------
# These encode the model-promotion gate. VALUE_DETECTION_ENABLED cannot be
# turned on without naming the model version that passed Phase 8B validation;
# the application refuses to start otherwise.
FEATURES__RESEARCH_MODE=true
FEATURES__VALUE_DETECTION_ENABLED=false
FEATURES__PROMOTED_MODEL_VERSION=
FEATURES__BOOKING_CODES_ENABLED=false
FEATURES__PAYMENTS_ENABLED=false
FEATURES__SCHEDULED_ODDS_CAPTURE_ENABLED=false


# --- Observability ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
OBSERVABILITY__LOG_LEVEL=INFO

# console for local development; MUST be json in production
OBSERVABILITY__LOG_FORMAT=console

OBSERVABILITY__LOG_SQL_QUERIES=false
OBSERVABILITY__HEARTBEAT_INTERVAL_SECONDS=15
OBSERVABILITY__HEARTBEAT_TTL_SECONDS=60
OBSERVABILITY__READINESS_TIMEOUT_SECONDS=3


# --- Host port mapping (docker-compose only) -------------------------------
API_PUBLISHED_PORT=8000
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
